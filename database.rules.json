{
  "rules": {
    ".read": false,
    ".write": false,
    "rooms": {
      "$roomCode": {
        ".read": "auth != null && $roomCode.matches(/^[A-Z0-9]{3,8}$/)",
        ".write": "auth != null && $roomCode.matches(/^[A-Z0-9]{3,8}$/) && ((!data.exists() && newData.child('hostId').val() === auth.uid) || data.child('hostId').val() === auth.uid)",
        "players": {
          "$playerId": {
            ".write": "auth != null && auth.uid === $playerId && data.parent().parent().child('hostId').exists()",
            "name": {
              ".validate": "newData.isString() && newData.val().length <= 30"
            },
            "score": {
              ".validate": "newData.isNumber() && (root.child('rooms').child($roomCode).child('hostId').val() === auth.uid || newData.val() === 0 || newData.val() === data.val())"
            },
            "connected": {
              ".validate": "newData.isBoolean()"
            },
            "avatar": {
              ".validate": "newData.isString() && newData.val().length <= 8"
            },
            "rematch": {
              ".validate": "newData.isBoolean()"
            },
            "marco": {
              ".validate": "newData.isString() && newData.val().matches(/^[a-z_]{1,20}$/)"
            },
            "titulo": {
              ".validate": "newData.isString() && newData.val().matches(/^[a-z_]{1,20}$/)"
            },
            "festejo": {
              ".validate": "newData.isString() && newData.val().matches(/^[a-z_]{1,20}$/)"
            },
            "$other": {
              ".validate": false
            }
          }
        },
        "answers": {
          "$round": {
            "$playerId": {
              ".write": "auth != null && auth.uid === $playerId && data.parent().parent().parent().child('players').child(auth.uid).exists()",
              "$category": {
                ".validate": "newData.isString() && newData.val().length <= 60"
              }
            }
          }
        },
        "status": {
          ".write": "auth != null && data.parent().child('players').child(auth.uid).exists() && ((data.val() === 'playing' && newData.val() === 'collecting') || newData.val() === data.val())"
        },
        "bastaBy": {
          ".write": "auth != null && data.parent().child('players').child(auth.uid).exists() && newData.val() === auth.uid"
        },
        "reviewReady": {
          "$round": {
            "$playerId": {
              ".write": "auth != null && auth.uid === $playerId && data.parent().parent().parent().child('players').child(auth.uid).exists()",
              ".validate": "newData.val() === true"
            }
          }
        },
        "objections": {
          "$round": {
            "$category": {
              "$targetId": {
                "$objectorId": {
                  ".write": "auth != null && auth.uid === $objectorId && root.child('rooms').child($roomCode).child('players').child(auth.uid).exists()",
                  ".validate": "newData.val() === true"
                }
              }
            }
          }
        },
        "reactions": {
          "$round": {
            "$category": {
              "$targetId": {
                "$emoji": {
                  "$reactorId": {
                    ".write": "auth != null && auth.uid === $reactorId && root.child('rooms').child($roomCode).child('players').child(auth.uid).exists()",
                    ".validate": "newData.val() === true && $emoji.length <= 16"
                  }
                }
              }
            }
          }
        },
        "accepted": {
          "$round": {
            "$category": {
              "$targetId": {
                ".write": "auth != null && auth.uid === $targetId && root.child('rooms').child($roomCode).child('players').child(auth.uid).exists()",
                ".validate": "newData.val() === true"
              }
            }
          }
        },
        "wins": {
          "$playerId": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1000"
          }
        },
        "votes": {
          "$round": {
            "$playerId": {
              ".write": "auth != null && auth.uid === $playerId && root.child('rooms').child($roomCode).child('players').child(auth.uid).exists() && root.child('rooms').child($roomCode).child('status').val() === 'voting'",
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 2"
            }
          }
        },
        "emotes": {
          "$playerId": {
            ".write": "auth != null && auth.uid === $playerId && root.child('rooms').child($roomCode).child('players').child(auth.uid).exists()",
            ".validate": "newData.hasChildren(['e', 'at'])",
            "e": {
              ".validate": "newData.isString() && newData.val().matches(/^[a-z]{2,12}$/)"
            },
            "at": {
              ".validate": "newData.isNumber() && newData.val() === now"
            },
            "$other": {
              ".validate": false
            }
          }
        }
      }
    },
    "queue": {
      ".read": "auth != null && query.orderByChild === 'status' && query.equalTo === 'waiting' && query.limitToFirst <= 5",
      ".indexOn": "status",
      "$playerId": {
        ".read": "auth != null",
        ".write": "auth != null && $playerId.matches(/^[A-Za-z0-9]{3,40}$/) && (auth.uid === $playerId || (data.exists() && newData.exists()))",
        "name": {
          ".validate": "newData.isString() && newData.val().length <= 30 && (auth.uid === $playerId || newData.val() === data.val())"
        },
        "status": {
          ".validate": "newData.isString() && newData.val().length <= 12"
        },
        "roomCode": {
          ".validate": "newData.isString() && newData.val().matches(/^[A-Z0-9]{3,8}$/)"
        },
        "avatar": {
          ".validate": "newData.isString() && newData.val().length <= 8"
        }
      }
    },
    "weekly": {
      "$week": {
        ".read": "auth != null && $week.matches(/^[0-9]{4}-W[0-9]{2}$/) && query.orderByChild === 'score' && query.limitToLast <= 10",
        ".indexOn": "score",
        "$uid": {
          ".write": "auth != null && auth.uid === $uid && $week.matches(/^[0-9]{4}-W[0-9]{2}$/)",
          ".validate": "newData.hasChildren(['name', 'score', 'rounds']) && (!data.exists() || newData.child('score').val() > data.child('score').val())",
          "name": {
            ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 30"
          },
          "avatar": {
            ".validate": "newData.isString() && newData.val().length <= 8"
          },
          "marco": {
            ".validate": "newData.isString() && newData.val().matches(/^[a-z_]{1,20}$/)"
          },
          "titulo": {
            ".validate": "newData.isString() && newData.val().matches(/^[a-z_]{1,20}$/)"
          },
          "ropa": {
            ".validate": "newData.isString() && newData.val().length <= 160 && newData.val().matches(/^[a-z0-9_:,]*$/)"
          },
          "$other": {
            ".validate": false
          },
          "score": {
            ".validate": "newData.isNumber() && newData.val() > 0 && newData.val() <= 100000"
          },
          "rounds": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 40 && newData.parent().child('score').val() <= (newData.val() + 1) * 90"
          },
          ".read": "auth != null && auth.uid === $uid"
        }
      }
    },
    "daily": {
      "$date": {
        ".read": "auth != null && $date.matches(/^[0-9]{4}-[0-9]{2}-[0-9]{2}$/) && query.orderByChild === 'score' && query.limitToLast <= 10",
        ".indexOn": "score",
        "$uid": {
          ".write": "auth != null && auth.uid === $uid && $date.matches(/^[0-9]{4}-[0-9]{2}-[0-9]{2}$/) && (!data.exists() || (newData.child('name').val() === '—' && newData.child('score').val() === data.child('score').val() && newData.child('valid').val() === data.child('valid').val() && newData.child('total').val() === data.child('total').val() && newData.child('grid').val() === data.child('grid').val()))",
          ".validate": "newData.hasChildren(['name', 'score', 'valid', 'total'])",
          "name": {
            ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 30"
          },
          "avatar": {
            ".validate": "newData.isString() && newData.val().length <= 8"
          },
          "marco": {
            ".validate": "newData.isString() && newData.val().matches(/^[a-z_]{1,20}$/)"
          },
          "titulo": {
            ".validate": "newData.isString() && newData.val().matches(/^[a-z_]{1,20}$/)"
          },
          "ropa": {
            ".validate": "newData.isString() && newData.val().length <= 160 && newData.val().matches(/^[a-z0-9_:,]*$/)"
          },
          "$other": {
            ".validate": false
          },
          "score": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 200 && newData.val() <= newData.parent().child('valid').val() * 10 + 70 + (newData.parent().child('valid').val() === newData.parent().child('total').val() ? 20 : 0)"
          },
          "valid": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= newData.parent().child('total').val()"
          },
          "total": {
            ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 10"
          },
          "grid": {
            ".validate": "newData.isString() && newData.val().matches(/^[01]{1,10}$/)"
          },
          ".read": "auth != null && auth.uid === $uid"
        }
      }
    },
    "duels": {
      "$duelId": {
        ".read": "auth != null && $duelId.matches(/^[A-Za-z0-9]{10}$/)",
        ".write": "auth != null && $duelId.matches(/^[A-Za-z0-9]{10}$/) && ((!data.exists() && newData.child('creator').child('uid').val() === auth.uid) || (data.exists() && !newData.exists() && data.child('creator').child('uid').val() === auth.uid))",
        ".validate": "newData.hasChildren(['letter', 'categories', 'wildcard', 'duration', 'createdAt', 'creator'])",
        "letter": {
          ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 2"
        },
        "categories": {
          "$i": {
            ".validate": "$i.matches(/^[0-9]$/) && newData.isString() && newData.val().length <= 40"
          }
        },
        "wildcard": {
          ".validate": "newData.isString() && newData.val().length <= 40"
        },
        "duration": {
          ".validate": "newData.isNumber() && newData.val() >= 10 && newData.val() <= 120"
        },
        "modo": {
          ".validate": "newData.isString() && newData.val().matches(/^(prohibida|largas|termina|lluvia)$/)"
        },
        "extra": {
          ".validate": "newData.isString() && newData.val().matches(/^[A-Z]?$/)"
        },
        "createdAt": {
          ".validate": "newData.isNumber() && (data.exists() ? newData.val() === data.val() : newData.val() === now)"
        },
        "creator": {
          "uid": {
            ".validate": "newData.val() === auth.uid"
          },
          ".validate": "newData.hasChildren(['name', 'avatar', 'score', 'valid', 'total', 'results'])",
          "name": {
            ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 30"
          },
          "avatar": {
            ".validate": "newData.isString() && newData.val().length <= 8"
          },
          "score": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 200"
          },
          "valid": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= newData.parent().child('total').val()"
          },
          "total": {
            ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 10"
          },
          "results": {
            "$i": {
              ".validate": "$i.matches(/^[0-9]$/) && newData.hasChildren(['v', 'ok'])",
              "v": {
                ".validate": "newData.isString() && newData.val().length <= 40"
              },
              "ok": {
                ".validate": "newData.isBoolean()"
              },
              "$other": {
                ".validate": false
              }
            }
          },
          "$other": {
            ".validate": false
          }
        },
        "rivals": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid && ((!data.exists() && data.parent().parent().exists()) || (data.exists() && !newData.exists()))",
            ".validate": "newData.hasChildren(['name', 'avatar', 'score', 'valid', 'total', 'results'])",
            "name": {
              ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 30"
            },
            "avatar": {
              ".validate": "newData.isString() && newData.val().length <= 8"
            },
            "score": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 200"
            },
            "valid": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= newData.parent().child('total').val()"
            },
            "total": {
              ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 10"
            },
            "results": {
              "$i": {
                ".validate": "$i.matches(/^[0-9]$/) && newData.hasChildren(['v', 'ok'])",
                "v": {
                  ".validate": "newData.isString() && newData.val().length <= 40"
                },
                "ok": {
                  ".validate": "newData.isBoolean()"
                },
                "$other": {
                  ".validate": false
                }
              }
            },
            "$other": {
              ".validate": false
            }
          }
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "duelInbox": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        "$duelId": {
          ".write": "auth != null && $duelId.matches(/^[A-Za-z0-9]{10}$/) && ((auth.uid === $uid && !newData.exists()) || (!data.exists() && $uid !== auth.uid && root.child('friends').child($uid).child(auth.uid).exists() && root.child('duels').child($duelId).child('creator').child('uid').val() === auth.uid))",
          ".validate": "newData.hasChildren(['from', 'name', 'avatar', 'score', 'at'])",
          "from": {
            ".validate": "newData.val() === auth.uid"
          },
          "name": {
            ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 30"
          },
          "avatar": {
            ".validate": "newData.isString() && newData.val().length <= 8"
          },
          "score": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 200"
          },
          "at": {
            ".validate": "newData.val() === now"
          },
          "$other": {
            ".validate": false
          }
        }
      }
    },
    "users": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid && auth.token.email != null",
        "data": {
          "$key": {
            ".validate": "$key.matches(/^tuttifruti_(adventure|wallet|progress|stats|streak_history|duels|daily|avatar|playerName|preset|app_diccionario|app_logros|app_aventura|app_frutigrama|app_copa)$/) && newData.isString() && (newData.val().length <= 30000 || ($key === 'tuttifruti_app_diccionario' && newData.val().length <= 100000))"
          }
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "profiles": {
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || root.child('friends').child($uid).child(auth.uid).exists())",
        ".write": "auth != null && auth.uid === $uid && auth.token.email != null",
        ".validate": "newData.hasChildren(['name', 'code', 'avatar', 'stats', 'updatedAt']) && root.child('friendCodes').child(newData.child('code').val()).val() === $uid",
        "name": {
          ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 30"
        },
        "code": {
          ".validate": "newData.isString() && newData.val().matches(/^[A-Z0-9]{6,12}$/)"
        },
        "avatar": {
          ".validate": "newData.isString() && newData.val().length <= 8"
        },
        "acc": {
          "hat": {
            ".validate": "newData.isString() && newData.val().length <= 20"
          },
          "glasses": {
            ".validate": "newData.isString() && newData.val().length <= 20"
          },
          "neck": {
            ".validate": "newData.isString() && newData.val().length <= 20"
          },
          "face": {
            ".validate": "newData.isString() && newData.val().length <= 20"
          },
          "hand": {
            ".validate": "newData.isString() && newData.val().length <= 20"
          },
          "$other": {
            ".validate": false
          }
        },
        "stats": {
          "stars": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1000000"
          },
          "ach": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1000000"
          },
          "wins": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1000000"
          },
          "best": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1000000"
          },
          "days": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1000000"
          },
          "games": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1000000"
          },
          "$other": {
            ".validate": false
          }
        },
        "bg": {
          ".validate": "newData.isString() && newData.val().length <= 20"
        },
        "marco": {
          ".validate": "newData.isString() && newData.val().matches(/^[a-z_]{1,20}$/)"
        },
        "titulo": {
          ".validate": "newData.isString() && newData.val().matches(/^[a-z_]{1,20}$/)"
        },
        "updatedAt": {
          ".validate": "newData.val() === now"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "friendCodes": {
      "$code": {
        ".read": "auth != null",
        ".write": "auth != null && ((auth.token.email != null && !data.exists() && newData.val() === auth.uid && $code.matches(/^[A-Z0-9]{6,12}$/)) || (data.val() === auth.uid && !newData.exists()))"
      }
    },
    "friends": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        "$fid": {
          ".write": "auth != null && auth.token.email != null && $fid !== $uid && (auth.uid === $uid || (auth.uid === $fid && (!newData.exists() || newData.val() === root.child('profiles').child($uid).child('code').val())))",
          ".validate": "newData.isString() && newData.val().length <= 12"
        }
      }
    },
    "friendRequests": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        "$from": {
          ".write": "auth != null && auth.token.email != null && $from !== $uid && ((auth.uid === $from && !data.exists()) || ((auth.uid === $uid || auth.uid === $from) && !newData.exists()))",
          ".validate": "newData.hasChildren(['name', 'avatar', 'code', 'at']) && root.child('friendCodes').child(newData.child('code').val()).val() === $from",
          "name": {
            ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 30"
          },
          "avatar": {
            ".validate": "newData.isString() && newData.val().length <= 8"
          },
          "code": {
            ".validate": "newData.isString() && newData.val().matches(/^[A-Z0-9]{6,12}$/)"
          },
          "at": {
            ".validate": "newData.val() === now"
          },
          "$other": {
            ".validate": false
          }
        }
      }
    },
    "referrals": {
      "$inviter": {
        ".read": "auth != null && auth.uid === $inviter",
        "$invitee": {
          ".write": "auth != null && auth.uid === $invitee && $invitee !== $inviter && !data.exists() && ((auth.token.email != null && !root.child('users').child($invitee).exists()) || (!root.child('referidos').child($invitee).exists() && newData.parent().parent().parent().child('referidos').child($invitee).val() === $inviter))",
          ".validate": "newData.isString() && root.child('friendCodes').child(newData.val()).val() === $inviter"
        }
      }
    },
    "referidos": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid && !data.exists()",
        ".validate": "newData.isString() && newData.val() !== $uid && newData.parent().parent().child('referrals').child(newData.val()).child($uid).exists()"
      }
    },
    "ligas": {
      "$semana": {
        "$div": {
          "$grupo": {
            ".read": "auth != null",
            "$uid": {
              ".write": "auth != null && auth.uid === $uid && $semana.matches(/^[0-9]{4}-W[0-9]{2}$/) && $div.matches(/^[0-4]$/) && $grupo.matches(/^[0-9]{1,5}$/)",
              ".validate": "newData.hasChildren(['name', 'xp', 'at']) && (data.exists() ? (newData.child('xp').val() >= data.child('xp').val() && newData.child('xp').val() - data.child('xp').val() <= 300 && (!data.child('at').exists() || newData.child('xp').val() - data.child('xp').val() <= (now - data.child('at').val()) / 250)) : newData.child('xp').val() <= 300)",
              "name": {
                ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 30"
              },
              "avatar": {
                ".validate": "newData.isString() && newData.val().length <= 8"
              },
              "xp": {
                ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 50000"
              },
              "at": {
                ".validate": "newData.val() === now"
              },
              "marco": {
                ".validate": "newData.isString() && newData.val().matches(/^[a-z_]{1,20}$/)"
              },
              "titulo": {
                ".validate": "newData.isString() && newData.val().matches(/^[a-z_]{1,20}$/)"
              },
              "ropa": {
                ".validate": "newData.isString() && newData.val().length <= 160 && newData.val().matches(/^[a-z0-9_:,]*$/)"
              },
              "$other": {
                ".validate": false
              }
            }
          }
        }
      }
    },
    "ligaCupos": {
      "$semana": {
        "$div": {
          ".read": "auth != null",
          ".write": "auth != null && $semana.matches(/^[0-9]{4}-W[0-9]{2}$/) && $div.matches(/^[0-4]$/)",
          ".validate": "newData.isNumber() && newData.val() === (data.exists() ? data.val() : 0) + 1"
        }
      }
    },
    "hoy": {
      "$dia": {
        "$uid": {
          ".read": "auth != null",
          ".write": "auth != null && auth.uid === $uid && $dia.matches(/^[0-9]{4}-[0-9]{2}-[0-9]{2}$/)",
          ".validate": "newData.hasChildren(['name', 'xp'])",
          "name": {
            ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 30"
          },
          "avatar": {
            ".validate": "newData.isString() && newData.val().length <= 8"
          },
          "xp": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 50000"
          },
          "daily": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 200"
          },
          "marco": {
            ".validate": "newData.isString() && newData.val().matches(/^[a-z_]{1,20}$/)"
          },
          "titulo": {
            ".validate": "newData.isString() && newData.val().matches(/^[a-z_]{1,20}$/)"
          },
          "fg": {
